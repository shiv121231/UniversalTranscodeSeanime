{
    "id": "universal-transcode",
    "name": "Universal Transcode",
    "version": "1.1.0",
    "manifestURI": "https://raw.githubusercontent.com/shiv121231/UniversalTranscodeSeanime/refs/heads/main/manifest.json",
    "language": "typescript",
    "type": "plugin",
    "description": "Web player for Seanime streams: direct play, direct stream or transcode (like Jellyfin), subtitle controls, skip opening/ending, cool mode for fanless laptops. Set it as Seanime's external player link. Windows, macOS and Linux.",
    "author": "shiv12131",
    "icon": "",
    "website": "",
    "readme": "",
    "notes": "Needs ffmpeg and Python 3 on the machine running the Seanime server.",
    "lang": "multi",
    "payloadURI": "https://raw.githubusercontent.com/shiv121231/UniversalTranscodeSeanime/refs/heads/main/code.ts",
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": [
                "system"
            ],
            "allow": {
                "readPaths": [
                    "$TEMP/**/*"
                ],
                "writePaths": [
                    "$TEMP/**/*"
                ],
                "commandScopes": [
                    {
                        "command": "python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "python",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "python3.exe",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "python.exe",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/usr/bin/python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/usr/bin/python",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/usr/local/bin/python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/opt/homebrew/bin/python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    }
                ]
            }
        }
    }
}
