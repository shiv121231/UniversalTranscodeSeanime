{
    "id": "universal-transcode",
    "name": "Universal Transcode",
    "version": "0.4.0",
    "manifestURI": "https://raw.githubusercontent.com/shiv121231/UniversalTranscodeSeanime/refs/heads/main/manifest.json",
    "language": "typescript",
    "type": "plugin",
    "description": "Transcodes torrent (and other) Seanime streams to H.264/AAC HLS with subtitles and opens a web player. Set it as Seanime's external player link.",
    "author": "you",
    "icon": "",
    "website": "",
    "readme": "",
    "notes": "Needs ffmpeg and Python 3 on the machine running the Seanime server.",
    "lang": "multi",
    "payloadURI": "https://raw.githubusercontent.com/shiv121231/UniversalTranscodeSeanime/refs/heads/main/code.ts",
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": [
                "system"
            ],
            "allow": {
                "readPaths": [
                    "$TEMP/**/*"
                ],
                "writePaths": [
                    "$TEMP/**/*"
                ],
                "commandScopes": [
                    {
                        "command": "python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/usr/bin/python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/opt/homebrew/bin/python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    },
                    {
                        "command": "/usr/local/bin/python3",
                        "args": [
                            {
                                "validator": "^.*seanime-transcode.*server\\.py$"
                            },
                            {
                                "validator": "$ARGS"
                            }
                        ]
                    }
                ]
            }
        }
    }
}
